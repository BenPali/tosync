WIREGUARD_PRIVATE_KEY=your_wireguard_private_key
SESSION_SECRET=your_openssl_rand_hex_32
# OPTIONAL first-boot seed: admin accounts live in SQLite (data/tosync.db).
# The normal way to create accounts is `node add-admin.js <username>` (works
# before the server ever starts, and at runtime — no restart needed). This var
# only populates an EMPTY database once, for pre-existing deploys upgrading
# from the env-based scheme; new setups can omit it entirely.
# ADMIN_USERS={"admin":"$2b$12$bcrypt_hash"}
# Storage caps in GB (IMPORTANT: app defaults are 10/50/150 — larger than many
# small hosts' disks; set these to fit yours or the storage-DoS caps never fire)
MAX_UPLOAD_GB=5
MAX_ROOM_STORAGE_GB=15
MAX_TOTAL_STORAGE_GB=40
