{
    "name": "tosync",
    "version": "3.1.0",
    "description": "Synchronized video streaming",
    "main": "server.js",
    "type": "module",
    "scripts": {
        "build": "node build.js",
        "clean": "rm -rf public private",
        "rebuild": "npm run clean && npm run build",
        "start": "node server.js",
        "start:torrent": "PORT=3001 ENABLE_TORRENTS=true node server.js",
        "dev": "nodemon server.js",
        "dev:docker": "nodemon --watch server.js --watch build.js --watch src --ext js,html,css,json --exec \"node build.js && node server.js\"",
        "test": "npm run test:unit && npm run test:e2e",
        "test:unit": "vitest run",
        "test:e2e": "npm run build && playwright test",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
    },
    "keywords": [
        "video",
        "streaming",
        "synchronized",
        "torrent",
        "webtorrent",
        "socket.io"
    ],
    "author": "Ben Pali",
    "license": "MIT",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "better-sqlite3": "^12.11.1",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "express-session": "^1.17.3",
        "file-type": "^21.1.1",
        "memorystore": "^1.6.8",
        "multer": "^1.4.5-lts.1",
        "parse-torrent-title": "^2.1.0",
        "socket.io": "^4.7.5",
        "srt-to-vtt": "^1.1.3",
        "subtitle": "^4.2.2-alpha.0",
        "undici": "^6.25.0",
        "webtorrent": "^2.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.60.0",
        "autoprefixer": "^10.5.0",
        "eslint": "^10.7.0",
        "globals": "^17.7.0",
        "jsdom": "^29.1.1",
        "nodemon": "^3.0.1",
        "postcss": "^8.5.10",
        "prettier": "^3.9.5",
        "tailwindcss": "^3.4.19",
        "vitest": "^4.1.7"
    },
    "allowScripts": {
        "better-sqlite3@12.11.1": true
    }
}
